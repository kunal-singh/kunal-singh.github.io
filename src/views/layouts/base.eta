<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.page.title %></title>
  
  <% /* Meta tags for SEO */ %>
  <% if (it.meta.description) { %>
  <meta name="description" content="<%= it.meta.description %>">
  <% } %>
  <% if (it.meta.keywords && it.meta.keywords.length > 0) { %>
  <meta name="keywords" content="<%= it.meta.keywords.join(', ') %>">
  <% } %>
  
  <% /* Open Graph tags */ %>
  <meta property="og:title" content="<%= it.page.title %>">
  <meta property="og:description" content="<%= it.meta.description || it.global.siteDescription %>">
  <meta property="og:type" content="website">
  
  <% /* Fonts */ %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  
  <% /* Pico CSS */ %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  
  <style>
    :root {
      /* Typography */
      --font-display: 'Playfair Display', Georgia, serif;
      --font-body: 'Inter', system-ui, sans-serif;
      
      /* Colors - Clean light theme */
      --color-bg: #f4f6f9;
      --color-bg-card: #ffffff;
      --color-text: #1e293b;
      --color-text-secondary: #64748b;
      --color-text-muted: #94a3b8;
      --color-accent: #334155;
      --color-border: #e2e8f0;
      --color-timeline: #cbd5e1;
      --color-timeline-active: #334155;
      
      /* Spacing */
      --section-padding: 4rem;
      --container-max: 48rem;
      
      /* Transitions */
      --transition: 0.2s ease;
      
      /* Pico overrides */
      --pico-font-family: var(--font-body);
      --pico-background-color: var(--color-bg);
      --pico-color: var(--color-text);
      --pico-muted-color: var(--color-text-secondary);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    html {
      scroll-behavior: smooth;
    }
    
    body {
      font-family: var(--font-body);
      font-weight: 400;
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.7;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 500;
      color: var(--color-text);
      line-height: 1.3;
    }
    
    h1 {
      font-size: clamp(2.5rem, 6vw, 4rem);
    }
    
    h2 {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      text-align: center;
      margin-bottom: 3rem;
    }
    
    h3 {
      font-size: 1.25rem;
      font-family: var(--font-body);
      font-weight: 600;
    }
    
    a {
      color: var(--color-accent);
      text-decoration: none;
      transition: opacity var(--transition);
    }
    
    a:hover {
      opacity: 0.7;
    }
    
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    
    main {
      flex: 1;
    }
    
    section {
      padding: var(--section-padding) 0;
    }
    
    /* ============================================
       HERO SECTION
    ============================================ */
    
    .hero {
      text-align: center;
      padding: 5rem 0 4rem;
    }
    
    .hero-avatar {
      width: 8rem;
      height: 8rem;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--color-border);
      margin: 0 auto 2rem;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }
    
    .hero-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    
    .hero-name {
      margin-bottom: 0.5rem;
    }
    
    .hero-tagline {
      font-size: 1.25rem;
      color: var(--color-text-secondary);
      font-weight: 500;
      margin-bottom: 1.5rem;
    }
    
    .hero-description {
      color: var(--color-text-secondary);
      max-width: 32rem;
      margin: 0 auto 1.5rem;
      line-height: 1.8;
    }
    
    .skill-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    
    .skill-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: var(--color-accent);
      color: #ffffff;
      border-radius: 2rem;
      font-size: 0.875rem;
      font-weight: 500;
    }
    
    .social-links {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
    }
    
    .social-link {
      width: 3rem;
      height: 3rem;
      border-radius: 50%;
      background: var(--color-bg-card);
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-secondary);
      transition: all var(--transition);
    }
    
    .social-link:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      opacity: 1;
    }
    
    .social-link svg {
      width: 1.25rem;
      height: 1.25rem;
    }
    
    /* ============================================
       EXPERIENCE SECTION
    ============================================ */
    
    .experience {
      background: var(--color-bg);
    }
    
    .timeline {
      position: relative;
      padding-left: 0;
    }
    
    .timeline::before {
      content: '';
      position: absolute;
      left: 1.5rem;
      top: 0.75rem;
      bottom: 0.75rem;
      width: 2px;
      background: var(--color-timeline);
      display: none;
    }
    
    .timeline-item {
      position: relative;
      margin-bottom: 1.5rem;
    }
    
    .timeline-item:last-child {
      margin-bottom: 0;
    }
    
    .timeline-marker {
      position: absolute;
      left: calc(1.5rem - 0.5rem);
      top: 1.5rem;
      width: 1rem;
      height: 1rem;
      border-radius: 50%;
      background: var(--color-bg);
      border: 2px solid var(--color-timeline);
      z-index: 1;
      transition: all var(--transition);
      display: none;
    }
    
    .timeline-marker--current {
      background: var(--color-timeline-active);
      border-color: var(--color-timeline-active);
    }
    
    .timeline-item:hover .timeline-marker {
      background: var(--color-timeline-active);
      border-color: var(--color-timeline-active);
      transform: scale(1.2);
    }
    
    .experience-card {
      background: var(--color-bg-card);
      border-radius: 0.75rem;
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      transition: all var(--transition);
      margin-left: 3rem;
    }
    
    .experience-card:hover {
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    }
    
    .experience-date {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }
    
    .experience-title {
      margin-bottom: 0.25rem;
    }
    
    .experience-company {
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      font-weight: 500;
      margin-bottom: 1rem;
    }
    
    .experience-description {
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      line-height: 1.7;
      margin: 0;
    }
    
    /* ============================================
       FOOTER
    ============================================ */
    
    .site-footer {
      padding: 2rem 0;
      border-top: 1px solid var(--color-border);
      text-align: center;
    }
    
    .copyright {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin: 0;
    }
    
    /* ============================================
       RESPONSIVE - TABLET
    ============================================ */
    
    @media (min-width: 640px) {
      .experience-card {
        padding: 2rem;
      }
    }
    
    /* ============================================
       DESKTOP - Show timeline
    ============================================ */
    
    @media (min-width: 1024px) {
      .timeline::before {
        display: block;
        left: 1.5rem;
      }
      
      .timeline-marker {
        display: block;
        left: calc(1.5rem - 0.625rem);
        width: 1.25rem;
        height: 1.25rem;
      }
      
      .experience-card {
        margin-left: 3.25rem;
      }
    }
    
    /* ============================================
       RESPONSIVE - DESKTOP
    ============================================ */
    
    @media (min-width: 1024px) {
      :root {
        --section-padding: 5rem;
        --container-max: 52rem;
      }
      
      .hero {
        padding: 6rem 0 5rem;
      }
      
      .hero-avatar {
        width: 10rem;
        height: 10rem;
      }
    }
  </style>
</head>
<body>
  <main>
    <%~ include("../pages/" + it.page.id, it) %>
  </main>
  
  <%~ include("../partials/footer", it) %>
</body>
</html>
