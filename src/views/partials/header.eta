<% /* Header Partial - Available data: it.global, it.header, it.page */ %>
<header class="site-header <%= it.header.cssClasses ? it.header.cssClasses.join(' ') : '' %>">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-text"><%= it.global.author %></span>
    </a>
    
    <% if (it.header.showNav) { %>
    <nav class="main-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <% it.global.navigation.forEach(function(item) { %>
        <li class="nav-item">
          <a 
            href="<%= item.href %>" 
            class="nav-link<%= item.active ? ' nav-link--active' : '' %>"
            <%= item.active ? 'aria-current="page"' : '' %>
          >
            <%= item.label %>
          </a>
        </li>
        <% }) %>
      </ul>
    </nav>
    <% } %>
  </div>
  
  <style>
    .site-header {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--color-border);
      background: rgba(13, 13, 18, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    
    .logo {
      text-decoration: none;
      color: var(--color-text-primary);
    }
    
    .logo-text {
      font-family: var(--font-display);
      font-size: 1.5rem;
      letter-spacing: 0.02em;
    }
    
    .logo:hover .logo-text {
      color: var(--color-accent);
    }
    
    .main-nav {
      display: flex;
    }
    
    .nav-list {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    
    .nav-link {
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      padding: 0.5rem 0;
      position: relative;
    }
    
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--color-accent);
      transition: width var(--transition-smooth);
    }
    
    .nav-link:hover,
    .nav-link--active {
      color: var(--color-text-primary);
    }
    
    .nav-link:hover::after,
    .nav-link--active::after {
      width: 100%;
    }
    
    @media (max-width: 640px) {
      .nav-list {
        gap: 1rem;
      }
      
      .nav-link {
        font-size: 0.875rem;
      }
    }
  </style>
</header>
