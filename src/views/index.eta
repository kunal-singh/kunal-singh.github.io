<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: #fff;
    }
    .container {
      text-align: center;
      padding: 2rem;
    }
    h1 {
      font-size: 3rem;
      margin-bottom: 0.5rem;
    }
    .tagline {
      color: #a0a0a0;
      font-size: 1.25rem;
      margin-bottom: 2rem;
    }
    .links {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }
    .links a {
      color: #fff;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border: 1px solid #fff;
      border-radius: 4px;
      transition: all 0.2s;
    }
    .links a:hover {
      background: #fff;
      color: #1a1a2e;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1><%= it.name %></h1>
    <p class="tagline"><%= it.tagline %></p>
    <div class="links">
      <a href="https://github.com/<%= it.github %>">GitHub</a>
      <a href="https://linkedin.com/in/<%= it.linkedin %>">LinkedIn</a>
      <a href="mailto:<%= it.email %>">Contact</a>
    </div>
  </div>
</body>
</html>